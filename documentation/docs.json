{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Arcane SDK",
  "description": "Integrate your game with Arcane Powered, and publish it from the publisher portal.",
  "colors": {
    "primary": "#0F766E",
    "light": "#2DD4BF",
    "dark": "#115E59"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "SDK",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index",
              "get-the-sdk",
              "quickstart",
              "contributing"
            ]
          },
          {
            "group": "Concepts",
            "pages": [
              "concepts/client",
              "concepts/local-development",
              "concepts/ownership",
              "concepts/session",
              "concepts/achievements",
              "concepts/friends",
              "concepts/lobbies",
              "concepts/coop-network",
              "concepts/errors"
            ]
          },
          {
            "group": "Engines",
            "pages": [
              "engines/unity",
              "engines/web"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "reference/rust-api",
              "reference/c-abi"
            ]
          }
        ]
      },
      {
        "tab": "Publisher portal",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "portal/index",
              "portal/publish-your-game"
            ]
          },
          {
            "group": "Your studio",
            "pages": [
              "portal/studio"
            ]
          },
          {
            "group": "Your game",
            "pages": [
              "portal/store-page",
              "portal/builds",
              "portal/review"
            ]
          },
          {
            "group": "Selling",
            "pages": [
              "portal/storefronts",
              "portal/selling-tools"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "icon": "github",
          "href": "https://github.com/Arcane-Powered/arcane-sdk"
        },
        {
          "anchor": "Publisher portal",
          "icon": "arrow-up-right-from-square",
          "href": "https://portal.arcane-powered.com"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "redirects": [
    {
      "source": "/publishing/getting-started",
      "destination": "/portal/publish-your-game"
    }
  ]
}
